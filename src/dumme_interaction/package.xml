<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dumme_interaction</name>
  <version>0.0.1</version>
  <description>Dumm-E social behaviours: wave on "hi", look at / search for a person on "dummy", lock and record on "start recording".</description>
  <maintainer email="sambhava06@gmail.com">asambhav</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>dumme_vision</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <!-- vosk comes from the workspace venv (ml/.venv); audio via arecord (alsa-utils, preinstalled on Ubuntu) -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
