<?xml version="1.0"?>
<robot name="dumme" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="is_sim" default="false"/>
  <xacro:arg name="is_ignition" default="true"/>
  <xacro:include filename="$(find dumme_description)/urdf/dumme_ros2_control.xacro"/>
  <xacro:include filename="$(find dumme_description)/urdf/dumme_gazebo.xacro"/>

  <link name="world"/>
  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>
  <!-- ================= BASE ================= -->

      <link name="base">
        <inertial>
          <origin xyz="-0.0237839 0.000116649 0.00941362" rpy="0 0 0"/>
          <mass value="0.104025"/>
          <inertia
            ixx="9.95555e-05"
            ixy="-8.55189e-07"
            ixz="2.92665e-05"
            iyy="0.000328745"
            iyz="5.95146e-08"
            izz="0.000398127"/>
        </inertial>

        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://dumme_description/meshes/base.STL" scale="0.1 0.1 0.1"/>
          </geometry>
          <material name="grey">
            <color rgba="0.62745 0.62745 0.62745 1"/>
          </material>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://dumme_description/meshes/base.STL" scale="0.1 0.1 0.1"/>
          </geometry>
        </collision>
      </link>
      <joint name="base_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="world"/>
        <child link="base"/>
      </joint>

      <!-- ================= SHOULDER ROTATION PLATE ================= -->

      <link name="shoulder_rotation_plate">

        <inertial>
          <origin xyz="-0.0114529 -0.0053798 0.0119053" rpy="0 0 0"/>
          <mass value="0.0984948"/>
          <inertia
            ixx="4.05014e-05"
            ixy="-1.00498e-06"
            ixz="-1.57263e-07"
            iyy="4.18665e-05"
            iyz="-8.32963e-08"
            izz="6.56715e-05"/>
        </inertial>

        <visual>
          <geometry>
            <mesh filename="package://dumme_description/meshes/shoulder_rotation_plate.STL" scale="0.1 0.1 0.1"/>
          </geometry>
          <material name="grey"/>
        </visual>

        <collision>
          <geometry>
            <mesh filename="package://dumme_description/meshes/shoulder_rotation_plate.STL" scale="0.1 0.1 0.1"/>
          </geometry>
        </collision>

      </link>

      <joint name="shoulder_rotation_plate_joint" type="revolute">

        <origin xyz="-0.053905 0 0.0776" rpy="0 0 0"/>

        <parent link="base"/>
        <child link="shoulder_rotation_plate"/>

        <axis xyz="0 0 -1"/>

        <limit
          lower="-3.14159"
          upper="3.14159"
          effort="10000"
          velocity="1"/>

      </joint>

      <!-- ================= SHOULDER ================= -->

      <link name="shoulder">

        <inertial>
          <origin xyz="0.0784683 0.0620218 0.0125424" rpy="0 0 0"/>
          <mass value="0.311766"/>
          <inertia
            ixx="0.000517463"
            ixy="-0.000654881"
            ixz="-0.000244486"
            iyy="0.00140426"
            iyz="-0.000130135"
            izz="0.00161872"/>
        </inertial>

        <visual>
          <geometry>
            <mesh filename="package://dumme_description/meshes/shoulder.STL" scale="0.1 0.1 0.1"/>
          </geometry>
          <material name="grey"/>
        </visual>

        <collision>
          <geometry>
            <mesh filename="package://dumme_description/meshes/shoulder.STL" scale="0.1 0.1 0.1"/>
          </geometry>
        </collision>

      </link>

      <joint name="shoulder_joint" type="revolute">

        <origin xyz="0.00015256 -0.020358 0.032475" rpy="0 0 0"/>

        <parent link="shoulder_rotation_plate"/>
        <child link="shoulder"/>

        <axis xyz="0.46808 -0.88369 0"/>

        <limit
          lower="-3.14159"
          upper="3.14159"
          effort="10000"
          velocity="1"/>

      </joint>

      <!-- ================= ELBOW ================= -->

      <link name="elbow">

        <inertial>
          <origin xyz="0.0186117 -0.00724311 0.00404616" rpy="0 0 0"/>
          <mass value="0.032642"/>
          <inertia
            ixx="4.61129e-06"
            ixy="-1.27607e-07"
            ixz="-7.76638e-07"
            iyy="4.90735e-06"
            iyz="-3.93574e-07"
            izz="7.10991e-06"/>
        </inertial>

        <visual>
          <geometry>
            <mesh filename="package://dumme_description/meshes/elbow.STL" scale="0.1 0.1 0.1"/>
          </geometry>
          <material name="blue"/>
        </visual>

        <collision>
          <geometry>
            <mesh filename="package://dumme_description/meshes/elbow.STL" scale="0.1 0.1 0.1"/>
          </geometry>
        </collision>

      </link>

      <joint name="elbow_joint" type="revolute">

        <origin xyz="0.16881 0.089319 0.059361" rpy="0 0 0"/>

        <parent link="shoulder"/>
        <child link="elbow"/>

        <axis xyz="-0.46808 0.88369 0"/>

        <limit
          lower="-3.14159"
          upper="3.14159"
          effort="10000"
          velocity="1"/>

      </joint>

      <!-- ================= WRIST ================= -->

  <link name="wrist">
    <inertial>
        <origin xyz="-0.00839865 0.00107016 0.00759796" rpy="0 0 0"/>
        <mass value="0.0259085"/>
        <inertia ixx="5.79148e-06" 
                 ixy="8.98589e-07" 
                 ixz="5.96188e-07" 
                 iyy="4.1426e-06" 
                 iyz="5.47716e-07" 
                 izz="5.94475e-06"/>
    </inertial>
    <visual>
        <geometry>
            <mesh filename="package://dumme_description/meshes/wrist.STL" scale="0.1 0.1 0.1"/>
        </geometry>
        <material name="grey"/>
    </visual>
    <collision>
        <geometry>
            <mesh filename="package://dumme_description/meshes/wrist.STL" scale="0.1 0.1 0.1"/>
        </geometry>
    </collision>
  </link>
  <joint name="wrist_joint" type="revolute">
    <origin xyz="0.11496 0.069435 0.041553" rpy="0 0 0"/>
    <parent link="elbow"/>
    <child link="wrist"/>
    <axis xyz="0.47573 -0.87959 0.0026889"/>
    <limit lower="-3.14159" upper="3.14159" effort="10000" velocity="1"/>
  </joint>

  <!-- ================= ESP32-CAM (wrist mounted) ================= -->
  <!-- Board sits flat on the wrist's chamfered end face (35 x 17 mm, 27.6 mm
       from the wrist pivot), lens facing straight out of that face. The
       40 mm board edge runs along the wrist joint axis. Camera looks along
       this link's +x axis.
       Tune these two properties to match where the board is really mounted. -->
  <xacro:property name="cam_xyz" value="-0.02452 -0.00111 0.02526"/>
  <xacro:property name="cam_rpy" value="-1.5708 -0.8576 -2.6545"/>

  <link name="rgb_camera">
    <!-- ESP32-CAM board: ~27 x 40 x 12 mm (incl. lens), ~10 g -->
    <visual>
      <geometry>
        <box size="0.012 0.027 0.040"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.012 0.027 0.040"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="1.94e-06"
        ixy="0"
        ixz="0"
        iyy="1.45e-06"
        iyz="0"
        izz="7.3e-07"/>
    </inertial>
  </link>

  <joint name="rgb_camera_joint" type="fixed">
    <origin xyz="${cam_xyz}" rpy="${cam_rpy}"/>
    <parent link="wrist"/>
    <child link="rgb_camera"/>
  </joint>

  <xacro:dumme_ros2_control/>

  <xacro:dumme_gazebo/>
</robot>
