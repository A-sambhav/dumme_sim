<?xml version="1.0"?>
<model>
  <name>bambu_a1</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    Bambu Lab A1 3D printer (visual only). Mesh extracted from the unofficial
    "Bambu Lab A1 - Detailed Cable-free" Fusion 360 model on MakerWorld
    (model 2397047) with tools/f3d_to_stl.py. Origin: centre of the base
    footprint on the floor, front (screen side) facing -Y.
  </description>
</model>
